#!/usr/bin/env python3
"""
249Shadow Cyber Lab — Challenge 01: Hidden in Plain Sight (Easy)
Official Digital Forensics Challenge Initializer
"""

import io
import os
import pathlib
import sys
import zipfile


def load_runtime_flag() -> str:
    """Read the instance flag from /flag without altering its contents."""
    flag_path = pathlib.Path("/flag")
    raw_flag = ""
    if flag_path.exists():
        try:
            raw_flag = flag_path.read_text(encoding="utf-8").strip()
        except Exception as e:
            sys.stderr.write(f"Warning: Could not read /flag: {e}\n")

    if not raw_flag:
        raw_flag = os.environ.get("FLAG", "").strip()

    if not raw_flag:
        raw_flag = "249shadow{forensics_test_fixture_01}"

    return raw_flag


def get_base_jpeg() -> bytes:
    """Returns valid baseline JPEG bytes ending at FF D9."""
    raw = bytes([
        0xFF, 0xD8, 0xFF, 0xE0, 0x00, 0x10, 0x4A, 0x46, 0x49, 0x46, 0x00, 0x01, 0x01, 0x01, 0x00, 0x48,
        0x00, 0x48, 0x00, 0x00, 0xFF, 0xDB, 0x00, 0x43, 0x00, 0x08, 0x06, 0x06, 0x07, 0x06, 0x05, 0x08,
        0x07, 0x07, 0x07, 0x09, 0x09, 0x08, 0x0A, 0x0C, 0x14, 0x0D, 0x0C, 0x0B, 0x0B, 0x0C, 0x19, 0x12,
        0x13, 0x0F, 0x14, 0x1D, 0x1A, 0x1F, 0x1E, 0x1D, 0x1A, 0x1C, 0x1C, 0x20, 0x24, 0x2E, 0x27, 0x20,
        0x22, 0x2C, 0x23, 0x1C, 0x1C, 0x28, 0x37, 0x29, 0x2C, 0x30, 0x31, 0x34, 0x34, 0x34, 0x1F, 0x27,
        0x39, 0x3D, 0x38, 0x32, 0x3C, 0x2E, 0x33, 0x34, 0x32, 0xFF, 0xC0, 0x00, 0x0B, 0x08, 0x01, 0x2C,
        0x01, 0x90, 0x01, 0x01, 0x11, 0x00, 0xFF, 0xC4, 0x00, 0x1F, 0x00, 0x00, 0x01, 0x05, 0x01, 0x01,
        0x01, 0x01, 0x01, 0x01, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x01, 0x02, 0x03, 0x04,
        0x05, 0x06, 0x07, 0x08, 0x09, 0x0A, 0x0B, 0xFF, 0xC4, 0x00, 0xB5, 0x10, 0x00, 0x02, 0x01, 0x03,
        0x03, 0x02, 0x04, 0x03, 0x05, 0x05, 0x04, 0x04, 0x00, 0x00, 0x01, 0x7D, 0x01, 0x02, 0x03, 0x00,
        0x04, 0x11, 0x05, 0x12, 0x21, 0x31, 0x41, 0x06, 0x13, 0x51, 0x61, 0x07, 0x22, 0x71, 0x14, 0x32,
        0x81, 0x91, 0xA1, 0x08, 0x23, 0x42, 0xB1, 0xC1, 0x15, 0x52, 0xD1, 0xF0, 0x24, 0x33, 0x62, 0x72,
        0x82, 0x09, 0x0A, 0x16, 0x17, 0x18, 0x19, 0x1A, 0x25, 0x26, 0x27, 0x28, 0x29, 0x2A, 0x34, 0x35,
        0x36, 0x37, 0x38, 0x39, 0x3A, 0x43, 0x44, 0x45, 0x46, 0x47, 0x48, 0x49, 0x4A, 0x53, 0x54, 0x55,
        0x56, 0x57, 0x58, 0x59, 0x5A, 0x63, 0x64, 0x65, 0x66, 0x67, 0x68, 0x69, 0x6A, 0x73, 0x74, 0x75,
        0x76, 0x77, 0x78, 0x79, 0x7A, 0x83, 0x84, 0x85, 0x86, 0x87, 0x88, 0x89, 0x8A, 0x92, 0x93, 0x94,
        0x95, 0x96, 0x97, 0x98, 0x99, 0x9A, 0xA2, 0xA3, 0xA4, 0xA5, 0xA6, 0xA7, 0xA8, 0xA9, 0xAA, 0xB2,
        0xB3, 0xB4, 0xB5, 0xB6, 0xB7, 0xB8, 0xB9, 0xBA, 0xC2, 0xC3, 0xC4, 0xC5, 0xC6, 0xC7, 0xC8, 0xC9,
        0xCA, 0xD2, 0xD3, 0xD4, 0xD5, 0xD6, 0xD7, 0xD8, 0xD9, 0xDA, 0xE1, 0xE2, 0xE3, 0xE4, 0xE5, 0xE6,
        0xE7, 0xE8, 0xE9, 0xEA, 0xF1, 0xF2, 0xF3, 0xF4, 0xF5, 0xF6, 0xF7, 0xF8, 0xF9, 0xFA, 0xFF, 0xDA,
        0x00, 0x08, 0x01, 0x01, 0x00, 0x00, 0x3F, 0x00, 0x7F, 0x00, 0xFF, 0xD9
    ])
    return raw


CASE_NOTES_TEXT = """================================================================================
249SHADOW CYBER LAB — DIGITAL FORENSICS INCIDENT LOG
================================================================================
CASE FILE ID:      DF-2026-0819-EVD
INCIDENT TYPE:     Suspicious Artifact Recovery
HOST WORKSTATION:  WKSTN-FIN-09 (Finance Department)
EXAMINER CALLSIGN: Operator 249-Alpha
STATUS:            EVIDENCE ACQUIRED // CHAIN OF CUSTODY VERIFIED
--------------------------------------------------------------------------------

EXECUTIVE SUMMARY:
During a perimeter incident investigation, an image artifact was retrieved from
a hidden temporary folder on workstation WKSTN-FIN-09.

According to the user, the file was sent as an innocuous screenshot attachment.
The file displays standard visual dimensions and opens in standard viewer
software without displaying rendering errors.

However, forensic triage flagged the artifact due to anomalous file structure
properties and anomalous trailing byte patterns recorded at the physical EOF.

RECOVERED ARTIFACT:
- evidence_photo.jpg

INVESTIGATOR OBJECTIVE:
1. Inspect the binary structure of 'evidence_photo.jpg'.
2. Identify anomalous data structures appended beyond the standard image boundary.
3. Extract the hidden container and retrieve the concealed note containing the flag.
================================================================================
"""


def main():
    flag = load_runtime_flag()

    # 1. Base JPEG image
    jpeg_bytes = get_base_jpeg()

    # 2. Deflated ZIP archive containing recovered_note.txt
    zip_buffer = io.BytesIO()
    with zipfile.ZipFile(zip_buffer, "w", compression=zipfile.ZIP_DEFLATED) as zf:
        zf.writestr("recovered_note.txt", flag + "\n")

    polyglot_bytes = jpeg_bytes + zip_buffer.getvalue()

    # Determine destination directory
    challenge_dir = pathlib.Path("/challenge")
    if challenge_dir.exists():
        target_dir = challenge_dir
    else:
        target_dir = pathlib.Path(__file__).parent

    img_path = target_dir / "evidence_photo.jpg"
    img_path.write_bytes(polyglot_bytes)
    img_path.chmod(0o644)

    notes_path = target_dir / "case-notes.txt"
    notes_path.write_text(CASE_NOTES_TEXT, encoding="utf-8")
    notes_path.chmod(0o644)

    # Replicate artifacts to /home/hacker
    hacker_home = pathlib.Path("/home/hacker")
    if hacker_home.exists():
        try:
            (hacker_home / "evidence_photo.jpg").write_bytes(polyglot_bytes)
            (hacker_home / "evidence_photo.jpg").chmod(0o644)
            (hacker_home / "case-notes.txt").write_text(CASE_NOTES_TEXT, encoding="utf-8")
            (hacker_home / "case-notes.txt").chmod(0o644)
        except Exception:
            pass

    # Safety: Remove .init inside container so generator source is not exposed
    this_script = pathlib.Path(__file__).resolve()
    is_in_container = pathlib.Path("/run/dojo").exists() or pathlib.Path("/.dockerenv").exists()
    if is_in_container and str(this_script).startswith("/challenge"):
        try:
            this_script.unlink()
        except Exception:
            pass


if __name__ == "__main__":
    main()
