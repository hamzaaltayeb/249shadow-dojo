#!/usr/bin/env python3
"""
Trust Boundary — .init
Runs as root inside the DOJO challenge container.
Starts the gateway simulation and writes participant artifacts.
"""

import os
import pathlib
import socket
import stat
import subprocess
import sys
import time

CHALLENGE_DIR  = pathlib.Path("/challenge")
GATEWAY_SCRIPT = CHALLENGE_DIR / "gateway.py"
DATA_DIR       = pathlib.Path("/var/lib/249shadow/trust-boundary")
HACKER_HOME    = pathlib.Path("/home/hacker")

GATEWAY_PORT = 8881


# ── flag ─────────────────────────────────────────────────────────────────────

def load_flag() -> str:
    p = pathlib.Path("/flag")
    if p.exists():
        try:
            return p.read_text(encoding="utf-8").strip()
        except Exception:
            pass
    flag = os.environ.get("FLAG", "").strip()
    return flag if flag else "249shadow{network_test_fixture_01}"


FLAG = load_flag()


# ── data directory ────────────────────────────────────────────────────────────

DATA_DIR.mkdir(parents=True, exist_ok=True)
DATA_DIR.chmod(0o700)


# ── start gateway ─────────────────────────────────────────────────────────────

proc = subprocess.Popen(
    [sys.executable, str(GATEWAY_SCRIPT)],
    env={**os.environ, "FLAG": FLAG},
    start_new_session=True,
    stdout=subprocess.DEVNULL,
    stderr=subprocess.DEVNULL,
)


# ── wait for gateway ──────────────────────────────────────────────────────────

def wait_for_port(host: str, port: int, timeout: float = 10.0) -> bool:
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        try:
            s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
            s.settimeout(0.5)
            s.connect((host, port))
            s.close()
            return True
        except Exception:
            time.sleep(0.1)
    return False


if not wait_for_port("127.0.0.1", GATEWAY_PORT):
    sys.stderr.write(f"[trust-boundary] Gateway failed to start on port {GATEWAY_PORT}\n")
    sys.exit(1)


# ── participant artifacts ─────────────────────────────────────────────────────

HACKER_HOME.mkdir(parents=True, exist_ok=True)

(HACKER_HOME / "network-topology.txt").write_text(
    "=== NETWORK TOPOLOGY — edge-fw ===\n"
    "\n"
    "  [USERS-NET]           [TRANSIT]            [MGMT-NET]\n"
    "  10.10.1.0/24          10.10.2.0/24         10.10.3.0/24\n"
    "       |                     |                     |\n"
    "   [fa0/0] ──────── edge-fw (10.10.2.1) ──── [fa0/1]\n"
    "                         router\n"
    "\n"
    "Hosts:\n"
    "  10.10.1.0/24  — User workstations (IT staff, contractors)\n"
    "  10.10.2.0/24  — Transit network (router interfaces)\n"
    "  10.10.3.0/24  — Management network (servers, consoles)\n"
    "  10.10.3.10    — NGDS Management Console (port 8443/tcp)\n"
    "\n"
    "Security intent:\n"
    "  Users (10.10.1.0/24) must NOT be able to reach management hosts (10.10.3.0/24).\n"
    "  Admin workstations in MGMT-NET may initiate sessions outbound.\n",
    encoding="utf-8",
)

(HACKER_HOME / "routing-table.txt").write_text(
    "=== ROUTING TABLE — edge-fw ===\n"
    "\n"
    "Destination      Gateway        Interface   Metric\n"
    "10.10.1.0/24     directly conn  fa0/0       0\n"
    "10.10.2.0/24     directly conn  (self)      0\n"
    "10.10.3.0/24     directly conn  fa0/1       0\n"
    "0.0.0.0/0        10.10.2.254    fa0/0       1\n"
    "\n"
    "No NAT configured. Packets are routed with source IP preserved.\n",
    encoding="utf-8",
)

(HACKER_HOME / "edge-firewall-acl.conf").write_text(
    "=== ACL CONFIGURATION — edge-fw ===\n"
    "\n"
    "access-list MGMT-PROTECT:\n"
    "  seq 10  DENY   ip 10.10.3.0/24  any              ! Block mgmt hosts from initiating outbound\n"
    "  seq 20  PERMIT ip any            any              ! Permit established/return traffic\n"
    "\n"
    "interface fa0/0\n"
    "  description USERS-NET\n"
    "  ip address 10.10.1.1/24\n"
    "  ! (no access-group configured)\n"
    "\n"
    "interface fa0/1\n"
    "  description MGMT-NET\n"
    "  ip address 10.10.3.1/24\n"
    "  ip access-group MGMT-PROTECT in\n"
    "\n"
    "! Intent: MGMT-PROTECT was meant to block user access to management.\n"
    "! Applied: fa0/1 inbound — inspects traffic ENTERING the router from MGMT-NET.\n",
    encoding="utf-8",
)

(HACKER_HOME / "change-log.txt").write_text(
    "=== FIREWALL CHANGE LOG — edge-fw ===\n"
    "\n"
    "Change ID : CHG-2024-0089\n"
    "Date      : 2024-03-01\n"
    "Engineer  : A. Hassan\n"
    "Ticket    : SEC-441 — Restrict user access to management network\n"
    "\n"
    "Description:\n"
    "  Added ACL 'MGMT-PROTECT' to prevent User Network hosts from accessing\n"
    "  the Management Network. ACL applied to interface fa0/1.\n"
    "\n"
    "Config applied:\n"
    "  interface fa0/1\n"
    "    ip access-group MGMT-PROTECT in\n"
    "\n"
    "Peer review: APPROVED (B. Khalid)\n"
    "Post-change test: PING 10.10.3.10 from 10.10.1.50 — no response (PASS)\n"
    "\n"
    "---\n"
    "\n"
    "Change ID : CHG-2024-0102\n"
    "Date      : 2024-03-14\n"
    "Engineer  : A. Hassan\n"
    "Ticket    : SEC-451 — Confirm ACL effectiveness after topology review\n"
    "\n"
    "Description:\n"
    "  Security team requested a walkthrough of ACL logic.\n"
    "  Engineer confirmed ACL is applied 'in' on fa0/1 and believed this\n"
    "  covers all traffic reaching MGMT-NET.\n"
    "\n"
    "Note from reviewer (B. Khalid):\n"
    "  'Review direction of ACL application. fa0/1 inbound inspects traffic\n"
    "   arriving FROM management side — not traffic arriving from users.\n"
    "   Recommend re-testing with an active TCP connection, not ICMP.'\n"
    "\n"
    "Status: OPEN — awaiting engineer response.\n",
    encoding="utf-8",
)


# ── lockdown ──────────────────────────────────────────────────────────────────

for restricted in [GATEWAY_SCRIPT, CHALLENGE_DIR / ".init"]:
    try:
        restricted.chmod(0o700)
    except Exception:
        pass

print(f"[trust-boundary] Gateway listening on 127.0.0.1:{GATEWAY_PORT} — ready.")
sys.exit(0)
